{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "App Uninstaller",
  "version": "0.1.2",
  "identifier": "com.ducaoya.app-uninstaller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "应用卸载器",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "theme": "Dark",
        "transparent": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
